---
import { getCollection } from "astro:content";
import SupplementList from "../components/supplements/SupplementList.astro";
import AmazonDisclosure from "../components/site/AmazonDisclosure.astro";
import AtAGlance from "../components/site/AtAGlance.astro";
import PageIntro from "../components/site/PageIntro.astro";
import PracticeDataNotice from "../components/site/PracticeDataNotice.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { routeMetadata } from "../data/site";
import { sortByOrder } from "../lib/content";

const entries = sortByOrder(await getCollection("supplements"));
const current = entries
  .filter((entry) => entry.data.status === "current")
  .sort((a, b) => Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured)) || a.data.order - b.data.order);
// Current items group by when they are actually taken, so items taken together
// render together. Items without a recorded time fall into the last group.
const whenGroups = [
  ["morning", "Morning"],
  ["daytime", "During the day"],
  ["evening", "Evening"],
  ["bedtime", "Before bed"]
] as const;
const currentByWhen = whenGroups
  .map(([key, label]) => ({ label, entries: current.filter((entry) => entry.data.when === key) }))
  .filter((group) => group.entries.length);
const currentUngrouped = current.filter((entry) => !entry.data.when);
const considering = entries.filter((entry) => entry.data.status === "considering");
const previouslyTried = entries.filter((entry) => entry.data.status === "previously-tried");
const sourceNotes = entries.filter((entry) => !entry.data.status && entry.data.sources?.length);
const linkedProducts = entries.filter((entry) => !entry.data.status && !entry.data.sources?.length && (entry.data.affiliate || entry.data.affiliates?.length));
const hasPracticeEntries = entries.some((entry) => entry.data.practiceOnly);
const glanceEntries = current.length ? current : sourceNotes.slice(0, 4);
const glanceItems = glanceEntries.map((entry) => ({
  label: entry.data.status === "current" ? "Current" : "Source note",
  title: entry.data.name,
  detail: [entry.data.dose, entry.data.timing, entry.data.frequency].filter(Boolean).join(" · ") || entry.data.summary,
  href: `#${entry.data.slug}`
}));
---

<BaseLayout
  title={routeMetadata["/supplements"].title}
  description={routeMetadata["/supplements"].description}
  canonicalPath="/supplements"
>
  <main id="main-content" class="page">
    <PageIntro eyebrow="01 / Supplements" title="Supplements" description="My current personal supplements, with sourced notes for additional context." />

    <AtAGlance items={glanceItems} />

    {hasPracticeEntries ? (
      <div class="wrap"><PracticeDataNotice>Practice placeholders below are not Tanner's stack.</PracticeDataNotice></div>
    ) : null}

    <div class="wrap"><AmazonDisclosure /></div>

    <div class="wrap stack" id="supplement-details">
      {currentByWhen.map((group) => (
        <SupplementList
          entries={group.entries}
          heading={group.label}
          emptyMessage="Nothing recorded here yet."
        />
      ))}
      {currentUngrouped.length ? <SupplementList entries={currentUngrouped} heading="Current" emptyMessage="No current supplement entries are published yet." /> : null}
      {linkedProducts.length ? <SupplementList entries={linkedProducts} heading="Saved product links" sectionLabel="Products" emptyMessage="No additional products are linked yet." /> : null}
      {considering.length ? <SupplementList entries={considering} heading="Considering" emptyMessage="Nothing is under consideration here right now." /> : null}
      {previouslyTried.length ? <SupplementList entries={previouslyTried} heading="Previously tried" emptyMessage="No previously tried entries are published yet." /> : null}
      {sourceNotes.length ? <SupplementList entries={sourceNotes} heading="Source notes" sectionLabel="Notes" emptyMessage="No sourced supplement notes are published yet." /> : null}
    </div>
  </main>
</BaseLayout>

<style>
  .stack { padding-bottom: 2.5rem; }
</style>
