---
import { getCollection } from "astro:content";
import SleepGroup from "../components/sleep/SleepGroup.astro";
import AtAGlance from "../components/site/AtAGlance.astro";
import PageIntro from "../components/site/PageIntro.astro";
import PracticeDataNotice from "../components/site/PracticeDataNotice.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { routeMetadata } from "../data/site";
import { sortByOrder } from "../lib/content";

const entries = sortByOrder(await getCollection("sleep"));
// Supplements that opt into the sleep stack render here too, linking back to
// their own entry rather than duplicating the content.
const sleepSupplements = sortByOrder(await getCollection("supplements")).filter(
  (entry) => entry.data.status === "current" && entry.data.stacks?.includes("sleep")
);
const current = entries
  .filter((entry) => entry.data.status === "current")
  .sort((a, b) => Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured)) || a.data.order - b.data.order);
// Environment and gear come before routine: the setup is the part people can
// act on immediately, and the routine notes read better after it.
const kinds = [
  ["Environment", "environment"],
  ["Gear", "gear"],
  ["Routine", "routine"],
  ["Tracking", "tracking"]
] as const;
const hasPracticeEntries = entries.some((entry) => entry.data.practiceOnly);
const glanceItems = current.map((entry) => ({
  label: entry.data.kind,
  title: entry.data.name,
  detail: [entry.data.timing, entry.data.frequency, entry.data.spec].filter(Boolean).join(" · ") || entry.data.summary,
  href: `#${entry.data.slug}`
}));
---

<BaseLayout
  title={routeMetadata["/sleep"].title}
  description={routeMetadata["/sleep"].description}
  canonicalPath="/sleep"
>
  <main id="main-content" class="page">
    <PageIntro eyebrow="02 / Sleep" title="Sleep" description="My routine, room, gear, and sleep tracking." />

    <AtAGlance items={glanceItems} />

    {hasPracticeEntries ? <div class="wrap"><PracticeDataNotice>Practice placeholders below are not Tanner's routine.</PracticeDataNotice></div> : null}

    <div class="wrap sleep-layout">
      {sleepSupplements.length ? (
        <section class="sleep-supplements" aria-labelledby="sleep-supplements-heading">
          <header>
            <p class="section-label">Night / Foundational</p>
            <h2 id="sleep-supplements-heading">Start here</h2>
            <p>The two I take every night. Full notes on the supplements page.</p>
          </header>
          <ul>
            {sleepSupplements.map((entry) => (
              <li>
                <a href={`/supplements#${entry.data.slug}`}>
                  <span class="supplement-label">
                    {entry.data.tier === "foundational" ? "Foundational" : "Current"}
                    {entry.data.dose ? ` · ${entry.data.dose}` : ""}
                  </span>
                  <strong>{entry.data.name}</strong>
                  <span class="supplement-summary">{entry.data.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      {kinds.map(([title, kind]) => (
        <SleepGroup title={title} entries={entries.filter((entry) => entry.data.kind === kind)} />
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .sleep-layout { padding-bottom: 2.5rem; }
  .sleep-supplements { padding-block: 1.8rem 2.4rem; border-top: 1px solid var(--line-strong); }
  .sleep-supplements header { display: grid; gap: .65rem; max-width: 43rem; margin-bottom: 1.25rem; }
  .sleep-supplements h2 { margin: 0; font-family: var(--serif); font-size: clamp(1.9rem, 7vw, 3.2rem); font-weight: 400; line-height: .96; }
  .sleep-supplements header > p:last-child { margin: 0; color: var(--muted); line-height: 1.45; }
  .sleep-supplements ul { display: grid; gap: .85rem; margin: 0; padding: 0; list-style: none; }

  @media (min-width: 48rem) {
    .sleep-supplements ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .sleep-supplements a {
    display: grid;
    gap: .35rem;
    border: 1px solid var(--sage-deep);
    border-top: 6px solid var(--sage-deep);
    padding: 1.15rem 1rem;
    background: rgba(248, 246, 238, .78);
    color: inherit;
    text-decoration: none;
  }
  .supplement-label { color: var(--sage-deep); font-size: .62rem; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
  .sleep-supplements strong { font-family: var(--serif); font-size: clamp(1.5rem, 5vw, 2rem); font-weight: 400; line-height: 1; }
  .supplement-summary { color: var(--ink); line-height: 1.5; }
  .sleep-supplements a:hover strong { color: var(--sage-deep); }

  @media (min-width: 48rem) {
    .sleep-supplements a { padding: 1.35rem 1.45rem; }
  }
</style>
